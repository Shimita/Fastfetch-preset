{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[92m┌─────────────────────── Sistema ───────────────────────────┐"
        },
        {
            "type": "os",
            "key": "│   OS",
            "keyColor": "green"
        },
        {
            "type": "de",
            "key": "│   DE",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "│   KE",
            "keyColor": "green"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": "│  󰔛 OS Age",
            "keyColor": "green",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "custom",
            "format": "\u001b[92m├─────────────────────── Recursos ───────────────────────────"
        },
        {
            "type": "memory",
            "key": "│    RAM",
            "keyColor": "green"
        },
        {
            "type": "swap",
            "key": "│  󰓡 Swap",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "│  󰋊  Esp",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[92m├─────────────────────── Hardware ───────────────────────────"
        },
        {
            "type": "board",
            "key": "│    MB",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│   CPU",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│  󰍛 GPU",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": "│      Memoria RAM",
            "keyColor": "green",
            "text": "ESC=$(printf '\\033'); sed \"1!s/^/${ESC}[92m│${ESC}[0m                    /\" /etc/apt/fastfetchMemory/memoria.txt"
        },
        {
            "type": "physicaldisk",
            "key": "│  󰋊 Almacenamiento",
            "keyColor": "green"
        },
        {
            "type": "monitor",
            "key": "│  󰍹 Monitor",
            "keyColor": "green"
        },
        {
            "type": "mouse",
            "key": "│    󰍽 Mouse",
            "keyColor": "green"
        },
        {
            "type": "keyboard",
            "key": "│   Teclado",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[92m├───────────────────── Sesion ───────────────────────────────"
        },
        {
            "type": "publicip",
            "key": "│  IP publico",
            "keyColor": "green"
        },
        {
            "type": "uptime",
            "key": "│ 󱑌  T. activo",
            "keyColor": "green"
        },
        {
            "type": "users",
            "key": "│    Usuarios",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[92m└───────────────────────────────────────────────────────────┘"
        }
 
    ]
}
